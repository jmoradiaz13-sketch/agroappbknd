USUARIO_BD=agroapp
CONTRASENA_BD=agroapp123
NOMBRE_BD=agroapp_bd
PUERTO_BD=5432
URL_BASE_DATOS=postgresql+psycopg2://agroapp:agroapp123@localhost:5432/agroapp_bd
SRID_ALMACENAMIENTO=4686
SRID_CLIENTE=4326
# URL pública del frontend (CORS). Producción: https://terraviva-ecru.vercel.app
URL_FRONTAL=http://localhost:5173
# Cadena de MongoDB (Atlas). NUNCA commits con la clave real: define el valor
# en tu .env local y en el dashboard de Render.
# Formato: mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/agroforapp?appName=Cluster0
MONGODB_URI=
# Fase 2: integraciones reales Copernicus (Sentinel-2 NDVI).
# Crea un OAuth client en https://dataspace.copernicus.eu/ y define aquí sus
# credenciales. Sin ellas, /analisis/ndvi-serie?modo=real responde 503 y la
# app usa la última serie cacheada en Dexie. El DEM GLO-30 no requiere claves.
COPERNICUS_ID_CLIENTE=
COPERNICUS_SECRETO_CLIENTE=
